APP_ENV=dev
APP_NAME=UE Agent Backend
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ROOT_PATH=
# Supports a single origin, comma-separated origins, or a JSON array.
APP_CORS_ORIGINS=http://127.0.0.1
LOG_LEVEL=INFO
DEBUG_JSON_SNAPSHOT=true

DATABASE_URL=sqlite:///./storage/app.db
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ue_agent_default

OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_ENABLED=false

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ue-agent-dev

RAG_MODE=hybrid
RAG_TOP_K=8
RAG_RERANK_TOP_N=20
RAG_FALLBACK_MODE=lexical_only

# Optional controlled Web Search evidence layer. Disabled by default; CI never
# depends on real network search. Use provider=mock with a local JSON fixture for
# offline tests, and keep real providers for later local smoke only.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=disabled
WEB_SEARCH_MAX_QUERIES=1
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=5000
WEB_SEARCH_MAX_CONTENT_CHARS=1200
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_ALLOWED_DOMAINS=dev.epicgames.com,docs.unrealengine.com,unrealengine.com
WEB_SEARCH_DOMAIN_BOOSTS=dev.epicgames.com:0.25,docs.unrealengine.com:0.25,unrealengine.com:0.15
WEB_SEARCH_MOCK_RESULTS_PATH=
# Optional lightweight Web Memory cache for controlled Web Search summaries.
# It stores URL/domain/snippet metadata only; it does not write web content into KB.
WEB_MEMORY_ENABLED=false
WEB_MEMORY_TTL_DAYS=30
WEB_MEMORY_MAX_RESULTS=5
WEB_MEMORY_MAX_ENTRIES=200
WEB_MEMORY_MIN_SCORE=0.08
WEB_MEMORY_FTS_ENABLED=true

STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
ARTIFACT_DIR=./storage/artifacts
KB_DIR=./storage/kb
# Supports comma-separated paths or a JSON array.
KB_SOURCE_PATHS=./knowledge
# Optional local-only private knowledge sources. Do not commit private content or .env.
# Example:
# KB_SOURCE_PATHS=./knowledge,../XG-UE-Cpp-Course-Skill-main/knowledge,../XG-UE-Cpp-Course-Skill-main/.trae/skills/xg-uecpp-course/references
KB_MAX_FILE_BYTES=5000000
KB_CHUNK_SIZE=600
KB_CHUNK_OVERLAP=100

# Optional MCP tool-layer adapter. HTTP remains the primary UE frontend/backend protocol.
MCP_TOOL_ADAPTER_ENABLED=false
MCP_STDIO_COMMAND=
# Supports comma-separated args or a JSON array.
MCP_STDIO_ARGS=
# Optional allow-list for read-only MCP tools, e.g. get_target_umg_asset,get_widget_tree.
MCP_ALLOWED_TOOLS=
MCP_STDIO_TIMEOUT_MS=3000
MCP_AUTO_DISCOVER_ON_STARTUP=false

DEFAULT_PROFILE_ID=default
DEFAULT_PROFILE_NAME=Default
DEFAULT_PROFILE_TEMPERATURE=0.2
DEFAULT_PROFILE_MAX_TOKENS=1200
DEFAULT_PROFILE_ALLOW_STREAMING=true
DEFAULT_PROFILE_DEBUG_MODE=true
DEFAULT_PROFILE_TOOL_TIMEOUT_MS=30000
DEFAULT_PROFILE_COST_GUARD_USD=3.0
