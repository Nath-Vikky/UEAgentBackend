# UEAgentCraft backend environment template.
# Copy this file to `.env`, then fill in local secrets and paths.
# Do not commit `.env`.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=dev
APP_NAME=UE Agent Backend
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ROOT_PATH=
APP_CORS_ORIGINS=http://127.0.0.1
LOG_LEVEL=INFO
DEBUG_JSON_SNAPSHOT=true

# -----------------------------------------------------------------------------
# Database and vector store
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/app.db
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ue_agent_default

# -----------------------------------------------------------------------------
# LLM and embedding
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_ENABLED=false

# -----------------------------------------------------------------------------
# Agent decision chain
# -----------------------------------------------------------------------------
# Default recommendation for local demo: let the LLM draft the route/tool plan,
# then let deterministic guards verify confidence, context, tool id, smalltalk,
# and Proposal-only write safety. If no LLM key is configured, the backend
# degrades to deterministic routing.
AGENT_INTENT_DRAFTER_MODE=active
AGENT_INTENT_DRAFTER_MIN_CONFIDENCE=0.78

# Signal detector is diagnostic by default. It records route signals but does
# not override the main decision chain.
ROUTER_SIGNAL_MODE=compatibility_observer
ROUTER_SIGNAL_MIN_CONFIDENCE=0.72
ROUTER_SIGNAL_MIN_MARGIN=8.0

# Framework-neutral DAG is the default. Optional LangGraph modes are reserved
# for future orchestration experiments.
AGENT_GRAPH_FRAMEWORK=framework_neutral

# -----------------------------------------------------------------------------
# RAG, local grep, and knowledge base
# -----------------------------------------------------------------------------
RAG_MODE=hybrid
RAG_TOP_K=8
RAG_RERANK_TOP_N=20
RAG_FALLBACK_MODE=lexical_only

STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
ARTIFACT_DIR=./storage/artifacts
KB_DIR=./storage/kb
KB_SOURCE_PATHS=./knowledge
KB_MAX_FILE_BYTES=5000000
KB_CHUNK_SIZE=600
KB_CHUNK_OVERLAP=100

# Optional local-only private knowledge sources. Do not commit private content
# or `.env`.
# KB_SOURCE_PATHS=./knowledge,../XG-UE-Cpp-Course-Skill-main/knowledge,../XG-UE-Cpp-Course-Skill-main/.trae/skills/xg-uecpp-course/references

# Project Inventory freshness gate, in seconds.
PROJECT_INVENTORY_STALE_AFTER_SECONDS=300

# -----------------------------------------------------------------------------
# Controlled web search and memory
# -----------------------------------------------------------------------------
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=disabled
WEB_SEARCH_MAX_QUERIES=1
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=5000
WEB_SEARCH_MAX_CONTENT_CHARS=1200
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_ALLOWED_DOMAINS=dev.epicgames.com,docs.unrealengine.com,unrealengine.com
WEB_SEARCH_DOMAIN_BOOSTS=dev.epicgames.com:0.25,docs.unrealengine.com:0.25,unrealengine.com:0.15
WEB_SEARCH_MOCK_RESULTS_PATH=

WEB_MEMORY_ENABLED=false
WEB_MEMORY_TTL_DAYS=30
WEB_MEMORY_MAX_RESULTS=5
WEB_MEMORY_MAX_ENTRIES=200
WEB_MEMORY_MIN_SCORE=0.08
WEB_MEMORY_FTS_ENABLED=true

LOCAL_MEMORY_ENABLED=false
LOCAL_MEMORY_ROOT=./runtime/memory
LOCAL_MEMORY_MAX_FILES=80
LOCAL_MEMORY_MAX_FILE_BYTES=120000

# -----------------------------------------------------------------------------
# MCP / external editor tool provider
# -----------------------------------------------------------------------------
# HTTP remains the primary UE frontend/backend protocol. Enable MCP only when a
# compatible tool provider is running.
MCP_TOOL_ADAPTER_ENABLED=false
MCP_TRANSPORT=stdio
MCP_STDIO_COMMAND=
MCP_STDIO_ARGS=
MCP_ALLOWED_TOOLS=
MCP_STDIO_TIMEOUT_MS=3000
MCP_TCP_HOST=127.0.0.1
MCP_TCP_PORT=8765
MCP_TCP_TIMEOUT_MS=3000
MCP_AUTO_DISCOVER_ON_STARTUP=false

# -----------------------------------------------------------------------------
# Runtime profile defaults
# -----------------------------------------------------------------------------
DEFAULT_PROFILE_ID=default
DEFAULT_PROFILE_NAME=Default
DEFAULT_PROFILE_TEMPERATURE=0.2
DEFAULT_PROFILE_MAX_TOKENS=1200
DEFAULT_PROFILE_ALLOW_STREAMING=true
DEFAULT_PROFILE_DEBUG_MODE=true
DEFAULT_PROFILE_TOOL_TIMEOUT_MS=30000
DEFAULT_PROFILE_COST_GUARD_USD=3.0
SESSION_COST_GUARD_USD=10.0

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ue-agent-dev

ALERT_ERROR_RATE_THRESHOLD=0.2
ALERT_P95_LATENCY_MS=2000
ALERT_HOURLY_COST_USD=5.0
ALERT_RAG_MISS_RATE=0.4
ALERT_KB_IMPORT_FAILURE_RATE=0.2
ALERT_PENDING_PROPOSALS_THRESHOLD=5
ALERT_PENDING_PROPOSAL_AGE_MINUTES=60
